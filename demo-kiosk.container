# ================================================================
# demo-kiosk.container — Podman Quadlet unit (user install)
# ================================================================
# Runs the Demo Kiosk SPA as a rootless systemd service via Podman
# Quadlet. The container image must be built on the host first:
#
#   podman build -t demo-kiosk:latest /path/to/faq-spa
#
# INSTALL (no root required):
#
#   1. Build the image (once, or after any content change):
#        podman build -t demo-kiosk:latest ~/faq-spa
#
#   2. Copy this file into the user Quadlet search path:
#        mkdir -p ~/.config/containers/systemd
#        cp demo-kiosk.container ~/.config/containers/systemd/
#
#   3. Reload the user systemd daemon:
#        systemctl --user daemon-reload
#
#   4. Start the service:
#        systemctl --user start demo-kiosk
#
#   5. Open in a browser:
#        http://localhost:8181
#        http://localhost:8181/#admin    ← usage statistics
#        http://localhost:8181/manage    ← upload content / edit cards
#
# AUTO-START ON BOOT (optional — requires lingering session):
#   The [Install] section below targets default.target, so the
#   service starts automatically when the user's session starts.
#   To also start it at boot before login, enable linger:
#
#        loginctl enable-linger
#
# USEFUL COMMANDS:
#   systemctl --user status demo-kiosk
#   systemctl --user stop   demo-kiosk
#   systemctl --user restart demo-kiosk
#   journalctl --user -u demo-kiosk -f
#
# UPDATING CONTENT:
#   After editing FAQ files or running download-libs.sh, rebuild
#   the image and restart the service:
#
#        podman build -t demo-kiosk:latest ~/faq-spa
#        systemctl --user restart demo-kiosk
#
# ── VOLUME OPTIONS FOR RUNTIME UPLOADS ───────────────────────────
#
# The /manage page lets you upload content and edit cards while the
# container is running.  Uploads require a writable content directory.
# Without a volume, uploads are rejected (the baked-in content is
# on the read-only container filesystem).  Two options:
#
# OPTION A — Named volume (recommended for runtime upload use):
#   Data lives in a Podman-managed volume; survives container restarts
#   and image rebuilds.  Create the volume once, then uncomment the
#   named Volume= line below.
#
#     podman volume create kiosk-content
#     # Uncomment:  Volume=kiosk-content:/srv/faq/content
#
#   Note: ReadOnly=true (below) only makes the container root filesystem
#   read-only. Named volumes are writable regardless of that setting.
#
# OPTION B — Bind mount (for local content authoring workflow):
#   The host directory is mounted directly into the container.
#   Use :rw so uploads can write back to the host directory.
#   Run build-faqs.py locally first to generate faqs.js.
#
#     # Uncomment:  Volume=%h/faq-spa/content:/srv/faq/content:rw
#
#   To keep the original read-only behaviour (no uploads, content
#   baked at build time), use :ro instead — uploads will be rejected
#   with a clear error in the /manage UI.
#
# ================================================================

[Unit]
Description=Demo Kiosk — Red Hat interactive demo platform
After=local-fs.target

[Container]
Image=quay.io/mmicene/demo-kiosk:latest
Pull=newer

# Publish container port 8181 to localhost IPv4 only.
# Podman's pasta network layer accepts IPv6 connections but resets them,
# causing Chrome to fail (the reset wins the Happy Eyeballs race over IPv4).
# Binding to 127.0.0.1 keeps pasta off IPv6 so Chrome falls back cleanly.
# To use a different port: change 8181 (left of :) to e.g. 9090:8181
PublishPort=127.0.0.1:8181:8181

# Predictable container name for `podman exec` and `podman logs`
ContainerName=demo-kiosk

# Run as read-only — the SPA serves static files and writes nothing
ReadOnly=true

# Required by --read-only: allow tmpfs on /tmp and /run inside container
ReadOnlyTmpfs=true

# Volume mount — uncomment ONE of the following (see header comments for details):
# Volume=kiosk-content:/srv/faq/content          ← named volume (option A, runtime uploads)
# Volume=%h/faq-spa/content:/srv/faq/content:rw  ← rw bind mount (option B, local authoring)
# Volume=%h/faq-spa/content:/srv/faq/content:ro  ← ro bind mount (no uploads, read-only)

# Healthcheck configuration for systemd integration
HealthCmd=["python3", "/srv/faq/healthcheck.py"]
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=15s
HealthRetries=3
HealthOnFailure=kill

# Wait for health before marking service started
Notify=healthy

[Service]
# Restart automatically if the container exits unexpectedly
Restart=on-failure

# Give Podman time to start (image may need to be decompressed on first run)
TimeoutStartSec=90

[Install]
# Start with the user's default systemd session target.
# Enable linger (`loginctl enable-linger`) to also start at boot.
WantedBy=default.target
