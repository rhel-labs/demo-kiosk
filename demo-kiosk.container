# ================================================================
# demo-kiosk.container — Podman Quadlet unit (user install)
# ================================================================
# Runs the Demo Kiosk SPA as a rootless systemd service via Podman
# Quadlet. The container image must be built on the host first:
#
#   podman build -t demo-kiosk:latest /path/to/demo-kiosk
#
# INSTALL (no root required):
#
#   1. Build the image (once, or after any content change):
#        podman build -t demo-kiosk:latest ~/demo-kiosk
#
#   2. Copy this file into the user Quadlet search path:
#        mkdir -p ~/.config/containers/systemd
#        cp demo-kiosk.container ~/.config/containers/systemd/
#
#   3. Reload the user systemd daemon:
#        systemctl --user daemon-reload
#
#   4. Start the service:
#        systemctl --user start demo-kiosk
#
#   5. Open in a browser:
#        http://localhost:8181
#        http://localhost:8181/#admin    ← usage statistics
#        http://localhost:8181/manage    ← upload content / edit cards
#
# AUTO-START ON BOOT (optional — requires lingering session):
#   The [Install] section below targets default.target, so the
#   service starts automatically when the user's session starts.
#   To also start it at boot before login, enable linger:
#
#        loginctl enable-linger
#
# USEFUL COMMANDS:
#   systemctl --user status demo-kiosk
#   systemctl --user stop   demo-kiosk
#   systemctl --user restart demo-kiosk
#   journalctl --user -u demo-kiosk -f
#
# UPDATING CONTENT:
#   After editing FAQ files or running download-libs.sh, rebuild
#   the image and restart the service:
#
#        podman build -t demo-kiosk:latest ~/demo-kiosk
#        systemctl --user restart demo-kiosk
#
# ── RUNTIME UPLOADS ──────────────────────────────────────────────
#
# The /manage page lets you upload content and edit cards while the
# container is running.  The named volume below (Volume=) makes this
# work out of the box:
#
#   • On first start Podman creates the volume and copies the baked
#     content from the image into it (:copy option).
#   • After that the volume persists across restarts and image updates
#     so uploaded files and card edits are never lost.
#   • ReadOnly=true only applies to the container root filesystem.
#     Named volumes are always writable regardless of that setting.
#
# ALTERNATIVE — bind mount for local content authoring:
#   Comment out the Volume= line and uncomment the bind-mount line.
#   The host directory is mounted directly; run build-faqs.py locally
#   first to generate faqs.js before starting the container.
#
# ================================================================

[Unit]
Description=Demo Kiosk — Red Hat interactive demo platform
After=local-fs.target

[Container]
Image=quay.io/mmicene/demo-kiosk:latest
Pull=newer

# Run pasta in IPv4-only mode — pasta would otherwise accept IPv6 connections
# and reset them, which wins Chrome's Happy Eyeballs race and causes failures.
# IPv4-only removes the reset entirely without restricting access to localhost.
Network=pasta:-4

# Publish container port 8181 on all IPv4 interfaces.
# To restrict to localhost only: PublishPort=127.0.0.1:8181:8181
# To use a different port: change 8181 (left of :) to e.g. 9090:8181
PublishPort=8181:8181

# Predictable container name for `podman exec` and `podman logs`
ContainerName=demo-kiosk

# Run as read-only — the container root filesystem is immutable.
# The named volume below is writable regardless of this flag, so
# /manage uploads and card edits work via the volume.
ReadOnly=true

# Required by --read-only: allow tmpfs on /tmp and /run inside container
ReadOnlyTmpfs=true

# Named volume — seeds from the image on first start, then persists across
# restarts and image updates so uploaded content is never lost.
Volume=kiosk-content:/srv/faq/content:copy

# Alternative: bind mount to a local directory (local content authoring workflow).
# Uncomment and comment out the Volume= line above to use instead.
# Volume=%h/demo-kiosk/content:/srv/faq/content:rw

# Healthcheck configuration for systemd integration
HealthCmd=["python3", "/srv/faq/healthcheck.py"]
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=15s
HealthRetries=3
HealthOnFailure=kill

# Wait for health before marking service started
Notify=healthy

[Service]
# Restart automatically if the container exits unexpectedly
Restart=on-failure

# SIGKILL (the container's STOPSIGNAL) produces exit code 137.
# Treat it as a clean stop so `systemctl stop` doesn't show "failed".
SuccessExitStatus=137

# Give Podman time to start and pass the first health check.
# The install script pre-pulls the image, so this window is only
# for container startup + the 30s health interval.
TimeoutStartSec=120

[Install]
# Start with the user's default systemd session target.
# Enable linger (`loginctl enable-linger`) to also start at boot.
WantedBy=default.target
