# ================================================================
# demo-kiosk.container — Podman Quadlet unit (user install)
# ================================================================
# Runs the Demo Kiosk SPA as a rootless systemd service via Podman
# Quadlet. The container image must be built on the host first:
#
#   podman build -t demo-kiosk:latest /path/to/faq-spa
#
# INSTALL (no root required):
#
#   1. Build the image (once, or after any content change):
#        podman build -t demo-kiosk:latest ~/faq-spa
#
#   2. Copy this file into the user Quadlet search path:
#        mkdir -p ~/.config/containers/systemd
#        cp demo-kiosk.container ~/.config/containers/systemd/
#
#   3. Reload the user systemd daemon:
#        systemctl --user daemon-reload
#
#   4. Start the service:
#        systemctl --user start demo-kiosk
#
#   5. Open in a browser:
#        http://localhost:8181
#        http://localhost:8181/#admin   ← usage statistics
#
# AUTO-START ON BOOT (optional — requires lingering session):
#   The [Install] section below targets default.target, so the
#   service starts automatically when the user's session starts.
#   To also start it at boot before login, enable linger:
#
#        loginctl enable-linger
#
# USEFUL COMMANDS:
#   systemctl --user status demo-kiosk
#   systemctl --user stop   demo-kiosk
#   systemctl --user restart demo-kiosk
#   journalctl --user -u demo-kiosk -f
#
# UPDATING CONTENT:
#   After editing FAQ files or running download-libs.sh, rebuild
#   the image and restart the service:
#
#        podman build -t demo-kiosk:latest ~/faq-spa
#        systemctl --user restart demo-kiosk
#
# VOLUME MOUNTING (alternative to rebuilding):
#   To update content without rebuilding, mount a content directory:
#
#     1. Uncomment the Volume= line below
#     2. Build content: python3 ~/faq-spa/build/build-faqs.py
#     3. Reload: systemctl --user daemon-reload
#     4. Restart: systemctl --user restart demo-kiosk
#
# ================================================================

[Unit]
Description=Demo Kiosk — Red Hat interactive demo platform
After=local-fs.target

[Container]
Image=quay.io/mmicene/demo-kiosk:latest
Pull=newer

# Publish container port 8181 to the same port on all host interfaces.
# Change the host side (left of :) to use a different port, e.g. 9090:8181
PublishPort=8181:8181

# Predictable container name for `podman exec` and `podman logs`
ContainerName=demo-kiosk

# Run as read-only — the SPA serves static files and writes nothing
ReadOnly=true

# Required by --read-only: allow tmpfs on /tmp and /run inside container
ReadOnlyTmpfs=true

# Uncomment to mount local content directory (update path as needed):
# Volume=%h/faq-spa/content:/srv/faq/content:ro

[Service]
# Restart automatically if the container exits unexpectedly
Restart=on-failure

# Give Podman time to start (image may need to be decompressed on first run)
TimeoutStartSec=90

[Install]
# Start with the user's default systemd session target.
# Enable linger (`loginctl enable-linger`) to also start at boot.
WantedBy=default.target
