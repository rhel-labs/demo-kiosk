# Local dev symlink — mirrors the container's /srv/faq layout so
# content/ is reachable when serve.py serves from app/.
# Not a source file; not present in the container image.
app/content

# Large media files — provided by event teams via Google Drive
# Binary assets excluded from git; YAML configs tracked for version control
content/media/*.mp4
content/media/*.mov
content/media/*.avi
content/media/*.webm
content/media/*.mkv
content/media/*.m4v

# Google Drive download bundles (auto-generated filenames)
# Contains media files to overlay onto content/media/ during build
kiosk*.zip

# Test data — large binary fixtures (media files, import/export bundles)
# not tracked in git; place any test inputs here regardless of which layer
# they exercise (kiosk, author tool, branding, etc.)
testdata/

# Event-specific FAQ content — delivered per-event, not stored in git.
# _template.yaml and the default onboarding cards are exceptions.
content/faqs/*.yaml
!content/faqs/_template.yaml
!content/faqs/00-upload.yaml
!content/faqs/01-creating-bundle.yaml
!content/faqs/02-card-types.yaml
!content/faqs/03-stats.yaml
!content/faqs/03-manage.yaml
content/*.yaml
!content/index.yaml

# Generated files built from the YAML content above.
# Run `python3 build/build-faqs.py` to regenerate locally.
content/faqs.js
content/branding.js

# npm-managed third-party libraries — installed by the asset-builder stage.
# Do not commit; update versions in package.json and regenerate package-lock.json.
node_modules/
app/patternfly.min.css
app/assets/fonts/
app/assets/pficon/
app/assets/asciinema-player.css
app/assets/asciinema-player.min.js
app/assets/pdf.min.js
app/assets/pdf.min.mjs
app/assets/pdf.worker.min.mjs

# Brand/event assets — delivered via the kiosk bundle, not stored in git.
app/assets/logo-redhat.svg
app/assets/logo-hummingbird.png
